@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Built with Secure ADS or not; also as component:
#   find_package(libads-client REQUIRED COMPONENTS secure)
set(libads-client_SECURE @LIBADS_CLIENT_SECURE_BOOL@)

find_dependency(Threads)
# libads-client uses inner headers of libads, so only exactly this version fits. First beside this installation.
find_package(libads @LIBADS_CLIENT_LIBADS_VERSION@ EXACT CONFIG QUIET PATHS "${PACKAGE_PREFIX_DIR}" NO_DEFAULT_PATH
    NO_CMAKE_FIND_ROOT_PATH)
find_dependency(libads @LIBADS_CLIENT_LIBADS_VERSION@ EXACT)
if(libads-client_SECURE)
    # Static library: mbedTLS is linked into the program that uses libads-client.
    # First beside this installation, where a fetched mbedTLS was installed (cmake/FetchMbedTLS.cmake). That path is
    # real already, so not below a cross-compiling CMAKE_FIND_ROOT_PATH.
    find_package(MbedTLS 3.6 CONFIG QUIET PATHS "${PACKAGE_PREFIX_DIR}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
    find_dependency(MbedTLS 3.6)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/libads-clientTargets.cmake")

set(libads-client_secure_FOUND ${libads-client_SECURE})
check_required_components(libads-client)
